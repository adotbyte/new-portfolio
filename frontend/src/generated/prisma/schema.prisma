generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "ai"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "ai"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  content   String
  embedding Unsupported("vector(1024)")? // 1024 dimensijos – Voyage AI numatytasis dydis
  source    String?
  createdAt DateTime @default(now())
}

model Memory {
  id        Int      @id @default(autoincrement())
  userId    String   // Susiejame su visitor_id
  fact      String   // Pvz., "Vartotojas domisi Docker"
  embedding Unsupported("vector(1024)")? // Voyage AI embeddingas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}